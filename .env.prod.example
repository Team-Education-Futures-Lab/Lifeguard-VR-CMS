# Production settings for the VPS. Copy this file to .env next to docker-compose.prod.yml and fill
# in the empty values. Never commit the filled-in .env. Use long, random passwords.

# --- Images and version (docker-compose.prod.yml) ---
# Registry and organisation, without a trailing slash, e.g. ghcr.io/<organisatie>
CMS_IMAGE_PREFIX=
# Version tag of both images, e.g. 1.0.0. A new version: change this, then pull and up -d.
CMS_VERSION=
# Port on the VPS where the webserver of the VPS reaches this app (only via 127.0.0.1)
CMS_HTTP_PORT=8080

# --- Folders on the VPS ---
# Uploaded logos, e.g. /srv/lifeguard/logos
CMS_LOGOS_PATH=
# Videos and thumbnails, e.g. /srv/lifeguard/videos. Never inside CMS_LOGOS_PATH.
CMS_VIDEOS_PATH=

# --- Database (MariaDB installed on the VPS) ---
# The VPS itself as seen from the container; only change this if MariaDB runs elsewhere
DB_HOST=host.docker.internal
# MariaDB default: 3306
DB_PORT=3306
# Database, user and password as created on the VPS (see README, "Op de VPS")
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- API ---
# Port inside the api container; nginx proxies to api:3000, so do not change it
API_PORT=3000
# Must stay true: the site runs on HTTPS via the webserver of the VPS
COOKIE_SECURE=true

# --- Optional: empty means the default between brackets ---
# Minutes of inactivity after which a session expires (60)
SESSION_IDLE_TIMEOUT_MINUTES=
# Maximum size of one video in GB, 1 GB = 1024^3 bytes (10)
VIDEO_MAX_SIZE_GB=
# Free disk space in GB that must remain after an upload (20)
VIDEO_MIN_FREE_SPACE_GB=
# Uploads at the same time per browser tab (1)
VIDEO_MAX_PARALLEL_UPLOADS=
# Hours without a new chunk after which an incomplete upload is removed (24)
UPLOAD_EXPIRY_HOURS=
# Maximum video frame size in pixels (5760 and 2880)
VIDEO_MAX_WIDTH=
VIDEO_MAX_HEIGHT=
# Default availability in the upload dialog: public, selective or private (private)
VIDEO_DEFAULT_VISIBILITY=
